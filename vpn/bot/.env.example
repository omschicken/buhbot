# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_CHAT_ID=your_telegram_id
SUPPORT_USERNAME=your_admin_username

# 3x-ui panel (your VPS)
XRAY_PANEL_URL=https://your-server.com:54321
XRAY_PANEL_USER=admin
XRAY_PANEL_PASS=yourpassword
